set(CMAKE_SYSTEM_NAME "@ATG_TARGET_SYSTEM@")
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER "@ATG_ZIG_EXECUTABLE@" cc -target "@ATG_ZIG_TARGET@")
set(CMAKE_AR "@ATG_ZIG_EXECUTABLE@")
# Avoid running a foreign executable during compiler detection.
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> ar qc <TARGET> <LINK_FLAGS> <OBJECTS>")
set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_AR> ranlib <TARGET>")
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(CMAKE_OSX_ARCHITECTURES x86_64)
    set(CMAKE_OSX_DEPLOYMENT_TARGET 11.0 CACHE STRING "Minimum macOS version")
endif()

set(CMAKE_USER_MAKE_RULES_OVERRIDE "@CMAKE_CURRENT_SOURCE_DIR@/cmake/ZigRules.cmake")
